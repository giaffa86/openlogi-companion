#: prefs.js:11
msgid "Panel"
msgstr "Pannello"

#: prefs.js:12
msgid "Pin devices from the menu. The choices last only for this session."
msgstr ""
"Fissa i dispositivi dal menu. Le scelte durano solo per questa sessione."

#: prefs.js:13
msgid "Show pinned devices in the panel"
msgstr "Mostra nel pannello i dispositivi fissati"

#: prefs.js:14
msgid ""
"Each device keeps its own icon and battery; refresh every 60 seconds, with a "
"longer delay after errors."
msgstr ""
"Ogni dispositivo mantiene la propria icona e batteria; aggiornamento ogni 60 "
"secondi, con attesa maggiore dopo errori."

#: prefs.js:17
msgid "Show battery as a bar"
msgstr "Mostra la batteria a tacca"

#: prefs.js:18
msgid ""
"Use a vertical bar instead of a numeric percentage for each pinned device."
msgstr ""
"Usa una tacca verticale al posto della percentuale numerica per ogni "
"dispositivo fissato."

#: prefs.js:21
msgid "Hide the extension icon when devices are pinned"
msgstr "Nascondi l’icona dell’estensione quando ci sono dispositivi fissati"

#: prefs.js:22
msgid "Requires at least one pinned device to be shown in the panel."
msgstr "Richiede che almeno un dispositivo fissato sia mostrato nel pannello."

#: shell/contract.js:76
msgid "Offline; battery reading is not current"
msgstr "Non in linea; la batteria non è aggiornata"

#: shell/contract.js:79 shell/contract.js:85
msgid "Battery unavailable"
msgstr "Batteria non disponibile"

#: shell/contract.js:80
msgid "Critical"
msgstr "Critica"

#: shell/contract.js:80
msgid "Low"
msgstr "Bassa"

#: shell/contract.js:80
msgid "Good"
msgstr "Buona"

#: shell/contract.js:80
msgid "Full"
msgstr "Piena"

#: shell/contract.js:81
msgid "Charging"
msgstr "In carica"

#: shell/contract.js:81
msgid "Charging slowly"
msgstr "Ricarica lenta"

#: shell/contract.js:81
msgid "Charged"
msgstr "Carica completa"

#: shell/contract.js:82
msgid "On battery"
msgstr "A batteria"

#: shell/contract.js:82
msgid "Charging error"
msgstr "Errore di ricarica"

#: shell/deviceRow.js:33 shell/deviceRow.js:49
msgid "Show this device in the panel"
msgstr "Mostra questo dispositivo nel pannello"

#: shell/deviceRow.js:43 shell/indicator.js:254 shell/indicator.js:259
msgid "Unnamed device"
msgstr "Dispositivo senza nome"

#: shell/deviceRow.js:44
msgid "Connected"
msgstr "Connesso"

#: shell/deviceRow.js:44
msgid "Disconnected"
msgstr "Disconnesso"

#: shell/deviceRow.js:49
msgid "Remove this device from the panel"
msgstr "Rimuovi questo dispositivo dal pannello"

#: shell/indicator.js:49
msgid "Loading…"
msgstr "Caricamento…"

#: shell/indicator.js:60
msgid "Show OpenLogi window"
msgstr "Mostra la finestra di OpenLogi"

#: shell/indicator.js:61
msgid "Refresh"
msgstr "Aggiorna"

#: shell/indicator.js:62
msgid "Extension preferences"
msgstr "Preferenze dell’estensione"

#: shell/indicator.js:130
msgid "Scanning devices…"
msgstr "Scansione dei dispositivi…"

#: shell/indicator.js:130 shell/indicator.js:153 shell/indicator.js:155
msgid "Inventory unavailable"
msgstr "Inventario indisponibile"

#: shell/indicator.js:134
msgid "Pin devices in the panel for this session."
msgstr "Fissa i dispositivi nel pannello per questa sessione."

#: shell/indicator.js:135
msgid "No devices"
msgstr "Nessun dispositivo"

#: shell/indicator.js:147
msgid "OpenLogi CLI is not installed"
msgstr "La CLI di OpenLogi non è installata"

#: shell/indicator.js:148
msgid "Cannot reach the OpenLogi agent"
msgstr "Agent di OpenLogi non raggiungibile"

#: shell/indicator.js:149
msgid "Incompatible CLI, agent or API schema"
msgstr "CLI, agent o schema API incompatibili"

#: shell/indicator.js:150
msgid "Invalid inventory data"
msgstr "Dati dell’inventario non validi"

#: shell/indicator.js:151
msgid "OpenLogi request timed out"
msgstr "Tempo scaduto per la richiesta a OpenLogi"

#: shell/indicator.js:152
msgid "OpenLogi output exceeds the limit"
msgstr "L’output di OpenLogi supera il limite"

#: shell/indicator.js:287
msgid "OpenLogi desktop application is not installed"
msgstr "L’applicazione OpenLogi non è installata"

#: shell/indicator.js:306
msgid "Could not open OpenLogi"
msgstr "Impossibile aprire OpenLogi"
